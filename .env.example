HIGHLIGHTLY_API_KEY=

# the-odds-api.com -> account key (player props; DraftKings). Also set on Railway's ingestion-worker.
ODDS_API_KEY=

# console.anthropic.com -> API key (natural-language search; Haiku). Also set on Railway's backend-api.
ANTHROPIC_API_KEY=

# Railway -> Postgres service -> Variables -> DATABASE_PUBLIC_URL (used by scripts on your Mac)
DATABASE_PUBLIC_URL=

# Weekly job (scripts/weekly.mjs). A production run needs WEEKLY_CONFIRM_PROD=1 and BACKUP_CONFIRM_PROD=1 (the launchd plist sets both). Do not put them in .env.
# Defaults are correct; uncomment only to override.
# WEEKLY_TUNNEL_PORT=55434
# WEEKLY_BACKUP_WAIT_S=600
# WEEKLY_STEP_TIMEOUT_S=3600
# WEEKLY_TUNNEL_TIMEOUT_S=60
# WEEKLY_PG_SERVICE=Postgres
# WEEKLY_RAILWAY_ENV=production
# WEEKLY_LOG=logs/weekly.log
# WEEKLY_NOTIFY=1
# Note: the weekly job no longer reads DATABASE_PUBLIC_URL from .env; it builds the tunnel URL in memory. Other scripts may still use it.
