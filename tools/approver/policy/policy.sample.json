{
  "policy_version": 1,
  "rules": {
    "D-PROD-RAILWAY": { "decision": "deny", "reason": "Railway commands are never approved." },
    "D-PROD-PSQL": { "decision": "deny", "reason": "Database client against a non-local or unknown host." },
    "D-PROD-VARS": { "decision": "deny", "reason": "Production confirmation or database URL variable named." },
    "D-SECRET-ENVFILE": { "decision": "deny", "reason": "A .env file is named." },
    "D-SECRET-PATH": { "decision": "deny", "reason": "A secrets, SSH key or Keychain path is named." },
    "D-SECRET-KEYCHAIN": { "decision": "deny", "reason": "Keychain access is never approved." },
    "D-SECRET-ENVDUMP": { "decision": "deny", "reason": "Environment dump or secret variable expansion." },
    "D-NET": { "decision": "deny", "reason": "Network call or posting data out." },
    "D-GIT-MAIN": { "decision": "deny", "reason": "Push to main or master." },
    "D-GIT-FORCE": { "decision": "deny", "reason": "Force push." },
    "D-GH": { "decision": "deny", "reason": "gh merge, release or workflow run." },
    "D-RM-RF": { "decision": "deny", "reason": "Recursive forced delete." },
    "D-SELF": { "decision": "deny", "reason": "Change to settings, hooks, the approver, its policy or log." },
    "K-INSTALL": { "decision": "ask", "reason": "Package install." },
    "K-SYS": { "decision": "ask", "reason": "Process or system command." },
    "K-ATTR": { "decision": "ask", "reason": "File flag or attribute change." },
    "K-SELF-READ": { "decision": "ask", "reason": "Read of a protected path." },
    "K-SELF-SRC": { "decision": "ask", "reason": "Edit of the approver source in the repo." },
    "K-OUTSIDE": { "decision": "ask", "reason": "Path outside the repo." },
    "K-PATH": { "decision": "ask", "reason": "Path on the ask list." },
    "K-BRANCH": { "decision": "ask", "reason": "Branch is main, master or unknown." },
    "K-UNICODE": { "decision": "ask", "reason": "Non-ASCII characters in the path." },
    "K-SHAPE": { "decision": "ask", "reason": "Unexpected request shape." },
    "K-DEFAULT": { "decision": "ask", "reason": "Not clearly matched by an allow rule." },
    "L-READ": { "decision": "allow", "reason": "Read-only inspection inside the repo." },
    "L-CD": { "decision": "allow", "reason": "cd into a repo subfolder." },
    "L-GIT-READ": { "decision": "allow", "reason": "Read-only git." },
    "L-GIT-BRANCH": { "decision": "allow", "reason": "git branch list." },
    "L-GIT-ADD": { "decision": "allow", "reason": "git add." },
    "L-GIT-COMMIT": { "decision": "allow", "reason": "git commit." },
    "L-GIT-NEWBRANCH": { "decision": "allow", "reason": "New feat/ or fix/ branch." },
    "L-GIT-PUSH": { "decision": "allow", "reason": "Push to origin feat/ or fix/." },
    "L-GH": { "decision": "allow", "reason": "gh pr create, view, checks, diff, comment." },
    "L-TEST": { "decision": "allow", "reason": "Tests and lint." },
    "L-DRILL": { "decision": "allow", "reason": "Exact drill command." },
    "L-EDIT": { "decision": "allow", "reason": "Edit inside the repo on a feature branch." }
  },
  "bash": {
    "railway": ["railway"],
    "db_clients": ["psql", "pg_dump", "pg_restore"],
    "local_hosts": ["localhost", "127.0.0.1", "::1"],
    "prod_vars": ["DATABASE_PUBLIC_URL", "WEEKLY_CONFIRM_PROD", "BACKUP_CONFIRM_PROD"],
    "keychain": ["security"],
    "env_dump": ["printenv"],
    "secret_var_regex": ["_KEY$", "_TOKEN$", "_SECRET$", "PASSWORD", "^DATABASE_"],
    "net": ["curl", "wget", "nc", "ncat", "netcat", "socat", "telnet", "ssh", "scp", "sftp", "ftp", "http", "https", "xh", "aria2c"],
    "install": { "npm": ["install", "i", "ci", "add"], "pnpm": ["install", "i", "add"], "yarn": ["add", "install"], "bun": ["install", "i", "add"], "pip": ["install"], "pip3": ["install"], "brew": ["install"], "gem": ["install"], "cargo": ["install", "add"] },
    "system": ["kill", "pkill", "killall", "chmod", "chown", "sudo", "launchctl"],
    "attr_changers": ["chflags", "xattr", "chattr", "setfacl", "setfattr", "setfile", "chgrp"],
    "tree_writers": ["rm", "mv", "chflags", "xattr", "chattr", "setfacl", "setfattr", "setfile", "chmod", "chown", "chgrp", "rmdir", "unlink", "shred"],
    "read_commands": ["cat", "head", "tail", "less", "more", "grep", "egrep", "fgrep", "rg", "ls", "wc", "file", "stat", "diff", "cmp", "strings", "od", "xxd", "hexdump", "du", "nl", "sort", "uniq", "cut", "readlink", "realpath", "basename", "dirname", "tree", "bat", "shasum", "md5", "cksum", "pwd", "which", "type", "cd", "pushd", "popd", "echo", "printf", "test", "["],
    "inline_code": ["python", "python2", "python3", "node", "perl", "ruby", "php", "deno", "bun", "osascript", "awk", "gawk", "sed"],
    "git_read_subcommands": ["status", "diff", "log", "show", "branch", "ls-files", "blame", "rev-parse", "grep", "describe", "shortlog", "ls-tree", "cat-file", "reflog", "remote", "tag", "stash"]
  },
  "paths": {
    "ask_globs": [".github/**", "ops/**", "**/package.json", "**/package-lock.json", "**/yarn.lock", "**/pnpm-lock.yaml", "**/bun.lockb", "**/npm-shrinkwrap.json", "db/schema.sql", "db/migrations/**", "**/Dockerfile*", "**/*.plist", "**/CLAUDE.md", "**/CLAUDE.local.md", "**/.ignore", "**/.rgignore", "**/.gitignore", "**/.gitattributes", "**/.npmrc", "**/.yarnrc*", "**/.mcp.json"],
    "approver_src_globs": ["tools/approver/**"],
    "secretish_globs": ["*.pem", "*.key", "*.p12", "*.pfx", "*.keystore", "credentials*", ".npmrc", ".netrc", "id_*"],
    "managed_dirs": ["/Library/Application Support/ClaudeCode"],
    "protected_markers": [".claude", "claude-approver", "application support/claudecode"]
  },
  "branches": {
    "protected": ["main", "master"],
    "new_branch_regex": "^(feat|fix)/[A-Za-z0-9._/-]+$"
  }
}
